# Required. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional. Model used for every stage. deepseek-chat supports JSON output mode,
# which the analysis and review stages use. deepseek-reasoner also works, but it
# ignores temperature and JSON mode, so those stages fall back to text parsing.
DEEPSEEK_MODEL=deepseek-chat

# Optional. "disabled" or "enabled". deepseek-flash thinks by default; "disabled" turns
# that off (faster, cheaper). Leave empty to not send the parameter at all.
DEEPSEEK_THINKING=disabled

# Optional. OpenAI-compatible base URL (no trailing /chat/completions).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Temperature for the editing passes (0-2). Lower is more conservative.
DEEPSEEK_TEMPERATURE=0.7
# Optional. Temperature for the analysis and review passes (0-2).
DEEPSEEK_ANALYSIS_TEMPERATURE=0.2

# Optional. Max completion tokens per call. Long drafts need room; 8192 is the
# deepseek-chat ceiling at the time of writing.
DEEPSEEK_MAX_TOKENS=8192

# Optional. Per-request timeout in milliseconds, and retries on 429/5xx/network errors.
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_RETRIES=2

# Optional. Character budget for the session digest sent to DeepSeek (roughly tokens x 4).
HUMANIZE_CONTEXT_BUDGET=24000

# Optional. How many repair rounds to run when the review finds high-severity problems (0-3).
HUMANIZE_REPAIR_ROUNDS=1

# Optional. Required top-level sections, separated by "|". The draft is checked for these
# and the output is normalised to exactly these H1 headings in this order.
# HUMANIZE_SECTIONS=High-Level Task Goal|Validation Notes|Decision Points|Difficulty & Codebase Understanding

# Optional. Use a different prompts directory without touching the code.
# HUMANIZE_PROMPTS_DIR=./prompts
